#### Regenerable output

# regenerated by `npm install`
# unanchored: npm also creates it below the root
node_modules/

# written by a build
/dist/

# written by Jest
/coverage/

# left in the root by `npm pack`
*.tgz

# written by `eslint --cache`
.eslintcache

#### for Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

#### for Mac
.DS_Store

#### environment to develop
.vscode/*
!.vscode/cspell.json
!.vscode/settings.json

#### Lock files
yarn.lock
pnpm-lock.yaml
bun.lockb

#### Secrets

# unused here (this stack reads `.env.<NODE_ENV>`), but it is the default name
# other dotenv tooling writes to, and where a credential lands
.env

# not authored here, but a repo cloned from this one will have them
# a secret committed once lives as long as the history does
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.gpg
id_rsa
id_dsa
id_ecdsa
id_ed25519
